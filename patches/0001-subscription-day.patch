@@ -0,0 +1,88 @@
+package billing
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	domainbilling "github.com/DEEIX-AI/DEEIX-Chat/backend/internal/domain/billing"
+)
+
+func TestProResolvePeriodEnd(t *testing.T) {
+	start := time.Date(2028, 2, 28, 12, 34, 56, 0, time.UTC)
+	for _, tc := range []struct {
+		interval string
+		cycles   int
+		want     time.Time
+	}{
+		{"day", 1, time.Date(2028, 2, 29, 12, 34, 56, 0, time.UTC)},
+		{"day", 3, time.Date(2028, 3, 2, 12, 34, 56, 0, time.UTC)},
+		{"day", 0, start.AddDate(0, 0, 1)},
+		{"day", -1, start.AddDate(0, 0, 1)},
+		{"month", 2, start.AddDate(0, 2, 0)},
+		{"year", 1, start.AddDate(1, 0, 0)},
+		{"unknown", 1, start.AddDate(0, 1, 0)},
+	} {
+		got := resolvePeriodEnd(start, tc.interval, tc.cycles)
+		if got == nil || !got.Equal(tc.want) {
+			t.Errorf("%s/%d: got %v, want %v", tc.interval, tc.cycles, got, tc.want)
+		}
+	}
+	if resolvePeriodEnd(start, "lifetime", 3) != nil {
+		t.Fatal("lifetime must have no expiry")
+	}
+	loc, err := time.LoadLocation("America/New_York")
+	if err != nil {
+		t.Fatal(err)
+	}
+	start = time.Date(2028, 3, 11, 12, 0, 0, 0, loc)
+	got := resolvePeriodEnd(start, "day", 1)
+	if got.Day() != 12 || got.Hour() != 12 || got.Sub(start) != 23*time.Hour {
+		t.Fatalf("calendar day across DST: %v", got)
+	}
+}
+
+func TestProSubscribeDaily(t *testing.T) {
+	repo := &billingRepositoryStub{
+		plans:  []domainbilling.Plan{{ID: 2, Code: "trial", IsActive: true}},
+		prices: []domainbilling.Price{{ID: 20, PlanID: 2, BillingInterval: "day", IsActive: true}},
+	}
+	sub, err := NewService(repo).Subscribe(context.Background(), 1, 20, 3)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if repo.replacedSubscription == nil || sub.CurrentPeriodEndAt == nil || !sub.CurrentPeriodEndAt.Equal(sub.CurrentPeriodStartAt.AddDate(0, 0, 3)) || !sub.AutoRenew {
+		t.Fatalf("daily subscription: %+v", sub)
+	}
+}
+
+type proDailyPaymentRepo struct {
+	billingRepositoryStub
+	order   domainbilling.PaymentOrder
+	granted *domainbilling.Subscription
+}
+
+func (r *proDailyPaymentRepo) GetPaymentOrderByOrderNo(context.Context, string) (*domainbilling.PaymentOrder, error) {
+	return &r.order, nil
+}
+func (r *proDailyPaymentRepo) MarkPaymentOrderPaidAndGrantSubscription(_ context.Context, _ string, _ string, _ time.Time, sub *domainbilling.Subscription) (*domainbilling.PaymentOrder, bool, error) {
+	r.granted = sub
+	r.order.Status = domainbilling.PaymentStatusPaid
+	return &r.order, true, nil
+}
+func TestProDailyPaymentCompletion(t *testing.T) {
+	repo := &proDailyPaymentRepo{order: domainbilling.PaymentOrder{UserID: 1, PlanID: 2, PriceID: 20, BillingInterval: "day", Cycles: 7}}
+	service := NewService(repo)
+	paidAt := time.Date(2026, 12, 29, 10, 0, 0, 0, time.UTC)
+	_, activated, err := service.CompletePaymentOrder(context.Background(), "daily", "payment", paidAt)
+	if err != nil || !activated {
+		t.Fatalf("complete: %v, %v", activated, err)
+	}
+	if repo.granted == nil || repo.granted.CurrentPeriodEndAt == nil || !repo.granted.CurrentPeriodEndAt.Equal(time.Date(2027, 1, 5, 10, 0, 0, 0, time.UTC)) {
+		t.Fatalf("grant: %+v", repo.granted)
+	}
+	_, activated, err = service.CompletePaymentOrder(context.Background(), "daily", "payment", paidAt)
+	if err != nil || activated {
+		t.Fatalf("duplicate callback: %v, %v", activated, err)
+	}
+}
