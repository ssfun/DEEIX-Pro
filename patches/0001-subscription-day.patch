@@ -0,0 +1,21 @@
+package billing
+
+import (
+	"encoding/json"
+	"github.com/gin-gonic/gin/binding"
+	"testing"
+)
+
+func TestProUpdateDailyPlanValidation(t *testing.T) {
+	for _, interval := range []string{"day", "month", "year", "lifetime", "week", ""} {
+		var req UpdateBillingPlanRequest
+		if err := json.Unmarshal([]byte(`{"name":"Daily","description":"trial","periodCreditUSD":5,"amountUSD":1,"billingInterval":"`+interval+`"}`), &req); err != nil {
+			t.Fatal(err)
+		}
+		err := binding.Validator.ValidateStruct(req)
+		valid := interval != "week" && interval != ""
+		if (err == nil) != valid {
+			t.Errorf("interval %q: %v", interval, err)
+		}
+	}
+}
