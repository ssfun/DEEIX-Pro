+func TestProQuotaCadenceChangeIncludesInFlightReservations(t *testing.T) {
+	for _, from := range []string{"day", "month"} {
+		t.Run(from, func(t *testing.T) {
+			db := openBillingSQLiteTestDB(t)
+			repo := NewRepo(db)
+			ctx := context.Background()
+			to := "day"
+			if from == "day" {
+				to = "month"
+			}
+			start, end := domainbilling.QuotaPeriodBounds(time.Now(), from)
+			req := domainbilling.UsageBalanceReservationRequest{UserID: 1, Mode: "period", RefNo: "before", RequestedNanousd: 100, PeriodStartAt: &start, PeriodEndAt: &end, PeriodCreditNanousd: 100}
+			if _, err := repo.ReserveUsageBalance(ctx, req); err != nil {
+				t.Fatal(err)
+			}
+			start, end = domainbilling.QuotaPeriodBounds(time.Now(), to)
+			req.RefNo = "after"
+			if _, err := repo.ReserveUsageBalance(ctx, req); !errors.Is(err, repository.ErrInsufficientBalance) {
+				t.Fatalf("reused reserved quota across %s -> %s: %v", from, to, err)
+			}
+		})
+	}
+}
+
+func TestProConcurrentDailyAdmissionCannotDoubleSpend(t *testing.T) {
+	db := openBillingSQLiteTestDB(t)
+	repo := NewRepo(db)
+	ctx := context.Background()
+	start, end := domainbilling.QuotaPeriodBounds(time.Now(), "day")
+	results := make(chan error, 2)
+	for i := 0; i < 2; i++ {
+		go func(index int) {
+			_, err := repo.ReserveUsageBalance(ctx, domainbilling.UsageBalanceReservationRequest{UserID: 1, Mode: "period", RefNo: fmt.Sprintf("daily-%d", index), RequestedNanousd: 500, PeriodStartAt: &start, PeriodEndAt: &end, PeriodCreditNanousd: 500})
+			results <- err
+		}(i)
+	}
+	successes := 0
+	for i := 0; i < 2; i++ {
+		err := <-results
+		if err == nil {
+			successes++
+		} else if !errors.Is(err, repository.ErrInsufficientBalance) {
+			t.Fatal(err)
+		}
+	}
+	if successes != 1 {
+		t.Fatalf("successful full-budget admissions: %d", successes)
+	}
+}
