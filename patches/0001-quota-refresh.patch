@@ -0,0 +1,33 @@
+package billing
+
+import (
+	"encoding/json"
+	appbilling "github.com/DEEIX-AI/DEEIX-Chat/backend/internal/application/billing"
+	"github.com/gin-gonic/gin/binding"
+	"testing"
+)
