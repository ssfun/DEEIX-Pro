+// NormalizeQuotaRefreshInterval preserves monthly behavior for existing plans.
+func NormalizeQuotaRefreshInterval(value string) string {
+	if strings.TrimSpace(value) == "day" {
+		return "day"
+	}
+	return "month"
+}
+
+// QuotaPeriodBounds uses server-local calendar boundaries, independently of subscription duration.
+func QuotaPeriodBounds(now time.Time, interval string) (time.Time, time.Time) {
+	if now.IsZero() {
+		now = time.Now()
+	}
+	now = now.In(time.Local)
+	year, month, day := now.Date()
+	if NormalizeQuotaRefreshInterval(interval) == "day" {
+		start := time.Date(year, month, day, 0, 0, 0, 0, now.Location())
+		return start, start.AddDate(0, 0, 1)
+	}
+	start := time.Date(year, month, 1, 0, 0, 0, 0, now.Location())
+	return start, start.AddDate(0, 1, 0)
+}
