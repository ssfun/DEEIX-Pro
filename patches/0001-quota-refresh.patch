+func TestProDailyQuotaOverviewWithoutRollover(t *testing.T) {
+	for _, interval := range []string{"month", "year", "lifetime"} {
+		t.Run(interval, func(t *testing.T) {
+			db := openBillingSQLiteTestDB(t)
+			if err := db.AutoMigrate(&model.BillingPlan{}, &model.BillingPrice{}, &model.Subscription{}, &model.SystemSetting{}); err != nil {
+				t.Fatal(err)
+			}
+			repo := NewRepo(db)
+			ctx := context.Background()
+			service := appbilling.NewService(repo)
+			now := time.Date(2026, 9, 21, 12, 0, 0, 0, time.Local)
+			start, end := domainbilling.QuotaPeriodBounds(now, "day")
+			plan := model.BillingPlan{Code: "pro", Name: "Pro", IsActive: true, QuotaRefreshInterval: "day", PeriodCreditNanousd: 500}
+			if err := db.Create(&plan).Error; err != nil {
+				t.Fatal(err)
+			}
+			price := model.BillingPrice{PlanID: plan.ID, Code: "pro-default", BillingInterval: interval, Currency: "USD", IsActive: true, IsDefault: true}
+			if err := db.Create(&price).Error; err != nil {
+				t.Fatal(err)
+			}
+			expiry := now.AddDate(0, 1, 0)
+			sub := model.Subscription{UserID: 1, PlanID: plan.ID, PriceID: price.ID, Status: "active", StartAt: start.AddDate(0, 0, -2), CurrentPeriodStartAt: start.AddDate(0, 0, -2), CurrentPeriodEndAt: &expiry}
+			if interval == "lifetime" {
+				sub.CurrentPeriodEndAt = nil
+			}
+			if err := db.Create(&sub).Error; err != nil {
+				t.Fatal(err)
+			}
+			if err := db.Create(&model.SystemSetting{Namespace: "billing", Key: "mode", Value: "period"}).Error; err != nil {
+				t.Fatal(err)
+			}
+			for _, row := range []model.UsageLedger{
+				{UserID: 1, BillingAt: start.Add(-time.Second), UsageDate: start.AddDate(0, 0, -1), BilledNanousd: 400},
+				{UserID: 1, BillingAt: start, UsageDate: start, BilledNanousd: 120},
+				{UserID: 1, BillingAt: now, UsageDate: start, BilledNanousd: 800, IsFreeModel: true},
+				{UserID: 2, BillingAt: now, UsageDate: start, BilledNanousd: 800},
+			} {
+				if err := db.Create(&row).Error; err != nil {
+					t.Fatal(err)
+				}
+			}
+			overview, err := service.GetBillingOverview(ctx, 1, now)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if overview.PeriodUsedNanousd != 120 || overview.PeriodRemainingNanousd != 380 || !overview.PeriodEndAt.Equal(end) || overview.Plan.QuotaRefreshInterval != "day" {
+				t.Fatalf("daily overview: %+v", overview)
+			}
+			daily, dailyErr := service.ListCurrentCycleDailyUsage(ctx, 1, now)
+			if dailyErr != nil || len(daily) != 1 {
+				t.Fatalf("quota daily report: %v %v", daily, dailyErr)
+			}
+			tomorrow, err := service.GetBillingOverview(ctx, 1, end)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tomorrow.PeriodRemainingNanousd != 500 || tomorrow.PeriodUsedNanousd != 0 {
+				t.Fatalf("daily credit rolled over: %+v", tomorrow)
+			}
+			if err := db.Model(&plan).Update("quota_refresh_interval", "month").Error; err != nil {
+				t.Fatal(err)
+			}
+			monthly, err := service.GetBillingOverview(ctx, 1, now)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if monthly.PeriodUsedNanousd != 520 || monthly.PeriodRemainingNanousd != 0 || monthly.PeriodStartAt.Day() != 1 {
+				t.Fatalf("monthly reset ignored prior consumption: %+v", monthly)
+			}
+			var stored model.Subscription
+			if err := db.First(&stored, sub.ID).Error; err != nil {
+				t.Fatal(err)
+			}
+			if (stored.CurrentPeriodEndAt == nil) != (sub.CurrentPeriodEndAt == nil) {
+				t.Fatal("quota refresh altered subscription")
+			}
+			if stored.CurrentPeriodEndAt != nil && !stored.CurrentPeriodEndAt.Equal(expiry) {
+				t.Fatal("quota refresh changed expiry")
+			}
+		})
+	}
+}
