+func TestProDailyReservationSettlementAcrossMidnight(t *testing.T) {
+	db := openBillingSQLiteTestDB(t)
+	repo := NewRepo(db)
+	ctx := context.Background()
+	today, tomorrow := domainbilling.QuotaPeriodBounds(time.Now(), "day")
+	yesterday := today.AddDate(0, 0, -1)
+	req := domainbilling.UsageBalanceReservationRequest{UserID: 1, Mode: "period", RefNo: "yesterday", RequestedNanousd: 100, PeriodStartAt: &yesterday, PeriodEndAt: &today, PeriodCreditNanousd: 500}
+	reservation, err := repo.ReserveUsageBalance(ctx, req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The old request was admitted yesterday and finishes after midnight.
+	if err := db.Model(&model.UsageReservation{}).Where("id = ?", reservation.ID).Update("created_at", today.Add(-time.Second)).Error; err != nil {
+		t.Fatal(err)
+	}
+	usage := &domainbilling.UsageLedger{UserID: 1, RefNo: "yesterday", BillingAt: today.Add(-time.Second), UsageDate: yesterday, BilledNanousd: 400}
+	if err := repo.AddPeriodUsageAndSettleOverage(ctx, usage, yesterday, today, 500, reservation); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.AddPeriodUsageAndSettleOverage(ctx, usage, yesterday, today, 500, reservation); err != nil {
+		t.Fatal(err)
+	}
+	used, err := repo.SumBillableNanousd(ctx, 1, yesterday, today)
+	if err != nil || used != 400 {
+		t.Fatalf("old period/idempotency: %d %v", used, err)
+	}
+	used, err = repo.SumBillableNanousd(ctx, 1, today, tomorrow)
+	if err != nil || used != 0 {
+		t.Fatalf("new day charged for yesterday: %d %v", used, err)
+	}
+	req.RefNo = "today"
+	req.PeriodStartAt = &today
+	req.PeriodEndAt = &tomorrow
+	req.RequestedNanousd = 500
+	fresh, err := repo.ReserveUsageBalance(ctx, req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fresh.PeriodCreditNanousd != 500 || fresh.BalanceNanousd != 0 {
+		t.Fatalf("new day quota: %+v", fresh)
+	}
+}
