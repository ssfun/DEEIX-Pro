+func TestProQuotaRefreshTransport(t *testing.T) {
+	for _, interval := range []string{"day", "month", "", "year", "invalid"} {
+		var req UpdateBillingPlanRequest
+		raw := `{"name":"Pro","description":"test","amountUSD":20,"periodCreditUSD":5,"billingInterval":"month","quotaRefreshInterval":"` + interval + `"}`
+		if err := json.Unmarshal([]byte(raw), &req); err != nil {
+			t.Fatal(err)
+		}
+		err := binding.Validator.ValidateStruct(req)
+		if (err == nil) != (interval == "day" || interval == "month" || interval == "") {
+			t.Fatalf("interval %q: %v", interval, err)
+		}
+		if err == nil && planUpdateInputFromRequest(req).QuotaRefreshInterval != interval {
+			t.Fatal("request lost quota interval")
+		}
+		req.BillingInterval = "day"
+		if binding.Validator.ValidateStruct(req) == nil {
+			t.Fatal("daily subscription must not be accepted")
+		}
+	}
+	result := toPlanListResponse([]appbilling.BillingPlanView{{QuotaRefreshInterval: "day"}})
+	if len(result) != 1 || result[0].QuotaRefreshInterval != "day" {
+		t.Fatal("response lost quota interval")
+	}
+}
