@@ -0,0 +1,42 @@
+package billing
+
+import (
+	"testing"
+	"time"
+)
+
+func TestProQuotaCalendarBoundaries(t *testing.T) {
+	original := time.Local
+	t.Cleanup(func() { time.Local = original })
+	time.Local = time.FixedZone("UTC+8", 8*60*60)
+	now := time.Date(2028, 2, 28, 16, 30, 0, 0, time.UTC)
+	start, end := QuotaPeriodBounds(now, "day")
+	if start.Format(time.RFC3339) != "2028-02-29T00:00:00+08:00" || end.Format(time.RFC3339) != "2028-03-01T00:00:00+08:00" {
+		t.Fatalf("daily: %v .. %v", start, end)
+	}
+	for _, interval := range []string{"month", ""} {
+		start, end = QuotaPeriodBounds(now, interval)
+		if start.Format("2006-01-02") != "2028-02-01" || end.Format("2006-01-02") != "2028-03-01" {
+			t.Fatalf("monthly: %v .. %v", start, end)
+		}
+	}
+	atBoundary, _ := QuotaPeriodBounds(end, "day")
+	if !atBoundary.Equal(end) {
+		t.Fatal("quota boundary must belong to the next period")
+	}
+	loc, err := time.LoadLocation("America/New_York")
+	if err != nil {
+		t.Fatal(err)
+	}
+	time.Local = loc
+	for _, tc := range []struct {
+		month time.Month
+		day   int
+		hours time.Duration
+	}{{3, 8, 23}, {11, 1, 25}} {
+		start, end = QuotaPeriodBounds(time.Date(2026, tc.month, tc.day, 12, 0, 0, 0, loc), "day")
+		if end.Sub(start) != tc.hours*time.Hour || start.Hour() != 0 || end.Hour() != 0 {
+			t.Fatalf("DST: %v .. %v", start, end)
+		}
+	}
+}
