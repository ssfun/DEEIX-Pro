+func TestProQuotaPlanMigrationAndPersistence(t *testing.T) {
+	db := openBillingSQLiteTestDB(t)
+	if err := db.AutoMigrate(&model.BillingPlan{}, &model.BillingPrice{}); err != nil {
+		t.Fatal(err)
+	}
+	plan := model.BillingPlan{Code: "pro", Name: "Pro", IsActive: true, PeriodCreditNanousd: 500}
+	if err := db.Create(&plan).Error; err != nil {
+		t.Fatal(err)
+	}
+	// Simulate a pre-feature database, then run the same model migration used by startup.
+	if err := db.Migrator().DropColumn(&model.BillingPlan{}, "quota_refresh_interval"); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&model.BillingPlan{}); err != nil {
+		t.Fatal(err)
+	}
+	repo := NewRepo(db)
+	ctx := context.Background()
+	got, err := repo.GetPlanByID(ctx, plan.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.QuotaRefreshInterval != "month" {
+		t.Fatalf("migration default: %+v", got)
+	}
+	got.QuotaRefreshInterval = "day"
+	price := &domainbilling.Price{PlanID: plan.ID, Code: "pro-default", BillingInterval: "year", Currency: "USD", IsDefault: true, IsActive: true}
+	if err := repo.UpdatePlanWithDefaultPrice(ctx, got, price); err != nil {
+		t.Fatal(err)
+	}
+	got, err = NewRepo(db).GetPlanByID(ctx, plan.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	prices, err := repo.ListActivePricesByPlanIDs(ctx, []uint{plan.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.QuotaRefreshInterval != "day" || len(prices) != 1 || prices[0].BillingInterval != "year" {
+		t.Fatalf("round trip: %+v %+v", got, prices)
+	}
+}
