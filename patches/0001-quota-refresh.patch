@@ -0,0 +1,49 @@
+package billing
+
+import (
+	"context"
+	"errors"
+	domainbilling "github.com/DEEIX-AI/DEEIX-Chat/backend/internal/domain/billing"
+	"testing"
+	"time"
+)
+
+func TestProUpdateQuotaCadencePreservesOldClientValue(t *testing.T) {
+	for _, interval := range []string{"", "day", "month", "year"} {
+		repo := &billingRepositoryStub{plans: []domainbilling.Plan{{ID: 2, Code: "pro", QuotaRefreshInterval: "day"}}}
+		service := NewService(repo)
+		service.SetPermissionGroupLookup(permissionGroupLookupStub{validIDs: map[uint]struct{}{1: {}}, defaultIDs: []uint{1}})
+		view, err := service.UpdatePlan(context.Background(), 2, PlanUpdateInput{Name: "Pro", BillingInterval: "year", QuotaRefreshInterval: interval, PeriodCreditNanousd: 500})
+		if interval == "year" {
+			if !errors.Is(err, ErrInvalidBillingPlan) {
+				t.Fatalf("invalid cadence: %v", err)
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := interval
+		if want == "" {
+			want = "day"
+		}
+		if repo.updatedPlan.QuotaRefreshInterval != want || view.QuotaRefreshInterval != want || repo.updatedPrice.BillingInterval != "year" {
+			t.Fatalf("cadence/subscription coupled: %+v", view)
+		}
+	}
+}
+
+func TestProDailySettlementKeepsAdmissionPeriod(t *testing.T) {
+	start := time.Date(2026, 9, 20, 0, 0, 0, 0, time.Local)
+	end := start.AddDate(0, 0, 1)
+	repo := &billingRepositoryStub{mode: "period"}
+	auth := &domainbilling.UsageAuthorization{Mode: "period", Reservation: &domainbilling.UsageBalanceReservation{Mode: "period", PeriodStartAt: &start, PeriodEndAt: &end, PeriodLimitNanousd: 500}}
+	usage := &domainbilling.UsageLedger{UserID: 1, BillingAt: end.Add(-time.Second), UsageDate: start, BilledNanousd: 100}
+	// No current-plan lookup: a midnight rollover or subsequent plan edit cannot move this charge.
+	if err := NewService(repo).RecordUsageWithAuthorization(context.Background(), usage, auth); err != nil {
+		t.Fatal(err)
+	}
+	if !repo.periodStartAt.Equal(start) || !repo.periodEndAt.Equal(end) || repo.periodCreditNanousd != 500 {
+		t.Fatal("settlement changed the admission snapshot")
+	}
+}
